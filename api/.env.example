# Postgres connection string used by Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/fwitter

# football-data.org API token for the fixtures/scores sync (free tier works; sync is
# disabled when empty). Get one at https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# Comma-separated emails promoted to ADMIN by scripts/seed.mjs (runs on every deploy).
# Admins manage roles for everyone else from the moderation dashboard.
ADMIN_EMAILS=

# AWS Cognito (User Pool used for auth — JWTs are validated against this pool's JWKS)
AWS_REGION=eu-north-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# --- Optional: only used by the dev scripts in scripts/ (seeding / manually minting a
# test token via SRP) — not required to run the API itself. ---
# TEST_EMAIL=
# TEST_PASSWORD=
# PROFILE_USERNAME=
# PROFILE_DISPLAY_NAME=
# PROFILE_DOB=

# Moderation dashboard (api/admin) build-time settings. Same pool and client as the
# mobile app. Needed wherever `npm run build` runs, including Railway.
VITE_AWS_REGION=eu-north-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=

# Image uploads (posts, avatars). Objects go to this bucket under uploads/<userId>/...
# and are scanned with Rekognition before going live. Credentials via the standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (an IAM user with s3:PutObject, GetObject,
# DeleteObject on the bucket and rekognition:DetectModerationLabels). Uploads are
# disabled when S3_BUCKET is empty.
S3_BUCKET=
# Region of the bucket and of the Rekognition scans. Rekognition is not offered in
# eu-north-1, so use a region that has it (eu-west-2 London is nearest) and create
# the bucket there. Defaults to AWS_REGION.
MEDIA_AWS_REGION=
# Optional CDN/CloudFront origin in front of the bucket (defaults to the S3 URL).
MEDIA_PUBLIC_BASE_URL=
# Optional override of the Rekognition top-level categories that reject an image.
# REKOGNITION_BLOCK=Explicit Nudity,Suggestive,Violence,Visually Disturbing,Rude Gestures,Drugs,Tobacco,Alcohol,Gambling,Hate Symbols

generator client {
  provider = "prisma-client-js"
  // REMOVE output =
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model follows {
  follower_id                       String   @db.Uuid
  following_id                      String   @db.Uuid
  created_at                        DateTime @default(now()) @db.Timestamptz(6)
  users_follows_follower_idTousers  users    @relation("follows_follower_idTousers", fields: [follower_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_follows_following_idTousers users    @relation("follows_following_idTousers", fields: [following_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([follower_id, following_id])
  @@index([follower_id])
  @@index([following_id])
}

model post_teams {
  post_id String @db.Uuid
  team_id String @db.Uuid
  posts   posts  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teams   teams  @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, team_id])
}

model post_topics {
  post_id  String @db.Uuid
  topic_id String @db.Uuid
  posts    posts  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  topics   topics @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, topic_id])
}

model posts {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id      String        @db.Uuid
  content        String
  parent_post_id String?       @db.Uuid
  /// Plain repost: this row has no content of its own and shows the original. Removed with the original.
  repost_of_id   String?       @db.Uuid
  /// Quote post: own content plus an embedded original. Nulled if the original is deleted (the quote then shows as a plain post).
  quoted_post_id String?       @db.Uuid
  /// Set when the post was made from a match hub; the post also appears in normal feeds.
  match_id       String?       @db.Uuid
  /// Hidden from everyone but the author (and moderators) once set: by reports reaching the
  /// auto-hide threshold ('reports') or by a moderator ('moderator'). Cleared on restore.
  hidden_at      DateTime?     @db.Timestamptz(6)
  hidden_reason  String?       @db.VarChar(20)
  /// Distinct reporters so far; drives the auto-hide threshold.
  report_count   Int           @default(0)
  /// Engagement counters, maintained in the same transactions as the rows they count. Used by ranking and the post shape.
  like_count     Int           @default(0)
  reply_count    Int           @default(0)
  repost_count   Int           @default(0)
  quote_count    Int           @default(0)
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime      @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?     @db.Timestamptz(6)
  post_teams     post_teams[]
  post_topics    post_topics[]
  post_likes     post_likes[]
  bookmarks      bookmarks[]
  post_mentions  post_mentions[]
  post_hashtags  post_hashtags[]
  polls          polls?
  notifications  notifications[]
  reports        reports[]
  media          media[]
  matches        matches?      @relation(fields: [match_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users          users         @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  posts          posts?        @relation("postsToposts", fields: [parent_post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_posts    posts[]       @relation("postsToposts")
  repost_of      posts?        @relation("reposts", fields: [repost_of_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reposts        posts[]       @relation("reposts")
  quoted_post    posts?        @relation("quotes", fields: [quoted_post_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  quotes         posts[]       @relation("quotes")

  /// One plain repost per user per post (NULL repost_of_id rows never collide).
  @@unique([author_id, repost_of_id], map: "idx_posts_one_repost_per_user")
  @@index([author_id, created_at(sort: Desc)], map: "idx_posts_author_created")
  @@index([parent_post_id], map: "idx_posts_parent")
  @@index([repost_of_id], map: "idx_posts_repost_of")
  @@index([quoted_post_id], map: "idx_posts_quoted")
  @@index([match_id, created_at(sort: Desc)], map: "idx_posts_match_created")
  @@index([hidden_at], map: "idx_posts_hidden")
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  SEXUAL
  VIOLENCE
  SELF_HARM
  UNDERAGE
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// A report targets exactly one of post_id / user_id / conversation_id. One report per reporter per target.
model reports {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id     String       @db.Uuid
  post_id         String?      @db.Uuid
  user_id         String?      @db.Uuid
  conversation_id String?      @db.Uuid
  reason      ReportReason
  details     String?      @db.VarChar(500)
  status      ReportStatus @default(OPEN)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  resolved_at DateTime?    @db.Timestamptz(6)
  resolved_by String?      @db.Uuid
  reporter    users        @relation("reports_reporter", fields: [reporter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  posts       posts?       @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reported    users?       @relation("reports_reported", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversation conversations? @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([reporter_id, post_id], map: "idx_reports_once_per_post")
  @@unique([reporter_id, user_id], map: "idx_reports_once_per_user")
  @@unique([reporter_id, conversation_id], map: "idx_reports_once_per_conversation")
  @@index([status, created_at(sort: Desc)])
  @@index([post_id])
  @@index([user_id])
}

/// One conversation per pair; user_a_id < user_b_id so the pair is unique. Read markers
/// per side drive unread counts. Not end-to-end encrypted: a reported conversation can be
/// read by moderators.
model conversations {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_a_id            String     @db.Uuid
  user_b_id            String     @db.Uuid
  created_at           DateTime   @default(now()) @db.Timestamptz(6)
  last_message_at      DateTime?  @db.Timestamptz(6)
  last_message_preview String?    @db.VarChar(120)
  a_last_read_at       DateTime?  @db.Timestamptz(6)
  b_last_read_at       DateTime?  @db.Timestamptz(6)
  user_a               users      @relation("conversation_a", fields: [user_a_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_b               users      @relation("conversation_b", fields: [user_b_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages             messages[]
  reports              reports[]

  @@unique([user_a_id, user_b_id])
  @@index([user_a_id, last_message_at(sort: Desc)])
  @@index([user_b_id, last_message_at(sort: Desc)])
}

model messages {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String        @db.Uuid
  sender_id       String        @db.Uuid
  content         String        @db.VarChar(1000)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  conversation    conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender          users         @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, created_at(sort: Desc)])
}

/// Two-way: neither side sees the other's posts, and follows between them are removed.
model blocks {
  blocker_id String   @db.Uuid
  blocked_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  blocker    users    @relation("blocks_blocker", fields: [blocker_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blocked    users    @relation("blocks_blocked", fields: [blocked_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([blocker_id, blocked_id])
  @@index([blocked_id])
}

/// Words that block a post, bio or name at submit. Stored lowercase; matched on word boundaries.
model banned_words {
  word       String   @id @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model post_likes {
  post_id    String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, user_id])
  @@index([user_id])
}

/// @username mentions resolved at post creation (unresolved names are not stored).
model post_mentions {
  post_id String @db.Uuid
  user_id String @db.Uuid
  posts   posts  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, user_id])
  @@index([user_id])
}

/// Tags are stored lowercase, so uniqueness is case-insensitive by construction.
model hashtags {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tag           String          @unique @db.VarChar(50)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  post_hashtags post_hashtags[]
}

model post_hashtags {
  post_id    String   @db.Uuid
  hashtag_id String   @db.Uuid
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  hashtags   hashtags @relation(fields: [hashtag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, hashtag_id])
  @@index([hashtag_id])
}

/// One poll per post; the post row is the poll's identity.
model polls {
  post_id      String         @id @db.Uuid
  ends_at      DateTime       @db.Timestamptz(6)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  posts        posts          @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  poll_options poll_options[]
  poll_votes   poll_votes[]
}

model poll_options {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poll_id    String       @db.Uuid
  position   Int          @db.SmallInt
  text       String       @db.VarChar(50)
  polls      polls        @relation(fields: [poll_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction)
  poll_votes poll_votes[]

  @@unique([poll_id, position])
}

/// One vote per user per poll; votes cannot be changed.
model poll_votes {
  poll_id      String       @db.Uuid
  user_id      String       @db.Uuid
  option_id    String       @db.Uuid
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  polls        polls        @relation(fields: [poll_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction)
  poll_options poll_options @relation(fields: [option_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([poll_id, user_id])
  @@index([option_id])
}

enum NotificationType {
  REPLY
  MENTION
  QUOTE
  LIKE
  REPOST
  FOLLOW
  WARNING
}

/// In-app activity. post_id is the reply/quote/mentioning post for those types and the
/// liked/reposted post for LIKE/REPOST; null for FOLLOW. Undoing a like, repost or follow
/// deletes its row, so toggling never piles up notifications.
model notifications {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String           @db.Uuid
  actor_id   String           @db.Uuid
  type       NotificationType
  post_id    String?          @db.Uuid
  /// Free text for WARNING notifications (what the moderator wrote).
  note       String?          @db.VarChar(300)
  created_at DateTime         @default(now()) @db.Timestamptz(6)
  read_at    DateTime?        @db.Timestamptz(6)
  recipient  users            @relation("notifications_recipient", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor      users            @relation("notifications_actor", fields: [actor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  posts      posts?           @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, actor_id, type, post_id], map: "idx_notifications_dedupe")
  @@index([user_id, created_at(sort: Desc)])
  @@index([user_id, read_at])
}

/// Expo push tokens, one row per device. Removed on sign-out and when Expo reports the device gone.
model push_tokens {
  token      String   @id @db.VarChar(200)
  user_id    String   @db.Uuid
  platform   String?  @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
}

enum MediaStatus {
  PENDING
  READY
  REJECTED
}

/// An uploaded image in S3. Created PENDING at presign, READY once the upload is confirmed
/// and has passed the Rekognition scan, REJECTED (object deleted, labels kept) otherwise.
/// Attached to a post at creation; avatars stay unattached.
model media {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id          String      @db.Uuid
  key               String      @unique @db.VarChar(255)
  content_type      String      @db.VarChar(50)
  purpose           String      @db.VarChar(20)
  size_bytes        Int?
  width             Int?
  height            Int?
  status            MediaStatus @default(PENDING)
  moderation_labels String?
  post_id           String?     @db.Uuid
  position          Int?        @db.SmallInt
  created_at        DateTime    @default(now()) @db.Timestamptz(6)
  owner             users       @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  posts             posts?      @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([post_id, position])
  @@index([owner_id, created_at(sort: Desc)])
}

/// Private "saved posts". Only ever read back by the user who saved them.
model bookmarks {
  user_id    String   @db.Uuid
  post_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, post_id])
  @@index([user_id, created_at(sort: Desc)])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model teams {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String       @db.VarChar(100)
  short_name   String?      @db.VarChar(50)
  city         String?      @db.VarChar(100)
  country      String?      @db.VarChar(100)
  league       String?      @db.VarChar(100)
  logo_url     String?
  /// football-data.org team id, set by the fixtures sync when it matches the name.
  external_id  Int?         @unique
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  post_teams   post_teams[]
  user_teams   user_teams[]
  home_matches matches[]    @relation("match_home")
  away_matches matches[]    @relation("match_away")
}

enum MatchStatus {
  SCHEDULED
  TIMED
  IN_PLAY
  PAUSED
  EXTRA_TIME
  PENALTY_SHOOTOUT
  FINISHED
  SUSPENDED
  POSTPONED
  CANCELLED
  AWARDED
}

/// Fixtures and scores from football-data.org. Team links are null until the sync maps
/// the API team onto a seeded team; names and crests are always stored so unmapped
/// teams still display.
model matches {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  external_id      Int         @unique
  competition      String      @db.VarChar(10)
  competition_name String      @db.VarChar(100)
  home_team_id     String?     @db.Uuid
  away_team_id     String?     @db.Uuid
  home_name        String      @db.VarChar(100)
  away_name        String      @db.VarChar(100)
  home_crest       String?
  away_crest       String?
  kickoff_at       DateTime    @db.Timestamptz(6)
  status           MatchStatus @default(SCHEDULED)
  minute           Int?
  home_score       Int?
  away_score       Int?
  updated_at       DateTime    @default(now()) @db.Timestamptz(6)
  home_team        teams?      @relation("match_home", fields: [home_team_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  away_team        teams?      @relation("match_away", fields: [away_team_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  posts            posts[]

  @@index([kickoff_at])
  @@index([status, kickoff_at])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model topics {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @db.VarChar(100)
  description String?
  icon        String?       @db.VarChar(50)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  post_topics post_topics[]
  user_topics user_topics[]
}

model user_teams {
  user_id    String   @db.Uuid
  team_id    String   @db.Uuid
  is_primary Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  teams      teams    @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, team_id])
}

model user_topics {
  user_id    String   @db.Uuid
  topic_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  topics     topics   @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, topic_id])
}

enum AgeTier {
  JUNIOR
  STANDARD
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum ModerationAction {
  HIDE_POST
  RESTORE_POST
  DELETE_POST
  WARN_USER
  SUSPEND_USER
  UNSUSPEND_USER
  BAN_USER
  UNBAN_USER
  SET_ROLE
  VERIFY_USER
  UNVERIFY_USER
  DISMISS_REPORTS
  ADD_BANNED_WORD
  REMOVE_BANNED_WORD
  GUARDIAN_DELETE_USER
}

/// Parental consent for JUNIOR accounts. One row per user, created when the guardian email is
/// first given. The link token is stored hashed and cleared once used; confirmed_at is the
/// consent record. STANDARD users have no row.
model guardian_consents {
  user_id          String    @id @db.Uuid
  guardian_email   String    @db.VarChar(255)
  token_hash       String?   @unique @db.VarChar(64)
  token_expires_at DateTime? @db.Timestamptz(6)
  sent_at          DateTime? @db.Timestamptz(6)
  confirmed_at     DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// Audit log of everything moderators do. Post targets are plain ids plus a content
/// snapshot, so the entry survives the post being deleted.
model moderation_actions {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id       String?          @db.Uuid
  action         ModerationAction
  target_user_id String?          @db.Uuid
  target_post_id String?          @db.Uuid
  post_snapshot  String?
  note           String?          @db.VarChar(500)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  actor          users?           @relation("moderation_actor", fields: [actor_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  target_user    users?           @relation("moderation_target", fields: [target_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([created_at(sort: Desc)])
  @@index([target_user_id])
  @@index([target_post_id])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id                                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                            String        @db.VarChar(30)
  display_name                        String        @db.VarChar(100)
  email                               String        @db.VarChar(255)
  bio                                 String?
  profile_image_url                   String?
  date_of_birth                       DateTime      @db.Date
  is_onboarded                        Boolean       @default(false)
  age_tier                            AgeTier       @default(STANDARD)
  role                                Role          @default(USER)
  /// Admin-granted badge (clubs, journalists, staff). Shown next to the name.
  verified_at                         DateTime?     @db.Timestamptz(6)
  /// Set by moderators. Checked on every authenticated request (cached briefly).
  suspended_until                     DateTime?     @db.Timestamptz(6)
  banned_at                           DateTime?     @db.Timestamptz(6)
  created_at                          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime      @default(now()) @db.Timestamptz(6)
  deleted_at                          DateTime?     @db.Timestamptz(6)
  cognito_sub                         String?       @unique @db.VarChar(64)
  follows_follows_follower_idTousers  follows[]     @relation("follows_follower_idTousers")
  follows_follows_following_idTousers follows[]     @relation("follows_following_idTousers")
  posts                               posts[]
  post_likes                          post_likes[]
  bookmarks                           bookmarks[]
  post_mentions                       post_mentions[]
  poll_votes                          poll_votes[]
  notifications_received              notifications[] @relation("notifications_recipient")
  notifications_sent                  notifications[] @relation("notifications_actor")
  push_tokens                         push_tokens[]
  reports_made                        reports[]       @relation("reports_reporter")
  reports_received                    reports[]       @relation("reports_reported")
  blocks_made                         blocks[]        @relation("blocks_blocker")
  blocks_received                     blocks[]        @relation("blocks_blocked")
  media                               media[]
  conversations_a                     conversations[] @relation("conversation_a")
  conversations_b                     conversations[] @relation("conversation_b")
  messages                            messages[]
  moderation_done                     moderation_actions[] @relation("moderation_actor")
  moderation_received                 moderation_actions[] @relation("moderation_target")
  guardian_consent                    guardian_consents?
  user_teams                          user_teams[]
  user_topics                         user_topics[]
}

generator client {
  provider = "prisma-client-js"
  // REMOVE output =
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model follows {
  follower_id                       String   @db.Uuid
  following_id                      String   @db.Uuid
  created_at                        DateTime @default(now()) @db.Timestamptz(6)
  users_follows_follower_idTousers  users    @relation("follows_follower_idTousers", fields: [follower_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_follows_following_idTousers users    @relation("follows_following_idTousers", fields: [following_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([follower_id, following_id])
  @@index([follower_id])
  @@index([following_id])
}

model post_teams {
  post_id String @db.Uuid
  team_id String @db.Uuid
  posts   posts  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teams   teams  @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, team_id])
}

model post_topics {
  post_id  String @db.Uuid
  topic_id String @db.Uuid
  posts    posts  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  topics   topics @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, topic_id])
}

model posts {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id      String        @db.Uuid
  content        String
  parent_post_id String?       @db.Uuid
  /// Plain repost: this row has no content of its own and shows the original. Removed with the original.
  repost_of_id   String?       @db.Uuid
  /// Quote post: own content plus an embedded original. Nulled if the original is deleted (the quote then shows as a plain post).
  quoted_post_id String?       @db.Uuid
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime      @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?     @db.Timestamptz(6)
  post_teams     post_teams[]
  post_topics    post_topics[]
  post_likes     post_likes[]
  bookmarks      bookmarks[]
  post_mentions  post_mentions[]
  post_hashtags  post_hashtags[]
  users          users         @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  posts          posts?        @relation("postsToposts", fields: [parent_post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_posts    posts[]       @relation("postsToposts")
  repost_of      posts?        @relation("reposts", fields: [repost_of_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reposts        posts[]       @relation("reposts")
  quoted_post    posts?        @relation("quotes", fields: [quoted_post_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  quotes         posts[]       @relation("quotes")

  /// One plain repost per user per post (NULL repost_of_id rows never collide).
  @@unique([author_id, repost_of_id], map: "idx_posts_one_repost_per_user")
  @@index([author_id, created_at(sort: Desc)], map: "idx_posts_author_created")
  @@index([parent_post_id], map: "idx_posts_parent")
  @@index([repost_of_id], map: "idx_posts_repost_of")
  @@index([quoted_post_id], map: "idx_posts_quoted")
}

model post_likes {
  post_id    String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, user_id])
  @@index([user_id])
}

/// @username mentions resolved at post creation (unresolved names are not stored).
model post_mentions {
  post_id String @db.Uuid
  user_id String @db.Uuid
  posts   posts  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, user_id])
  @@index([user_id])
}

/// Tags are stored lowercase, so uniqueness is case-insensitive by construction.
model hashtags {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tag           String          @unique @db.VarChar(50)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  post_hashtags post_hashtags[]
}

model post_hashtags {
  post_id    String   @db.Uuid
  hashtag_id String   @db.Uuid
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  hashtags   hashtags @relation(fields: [hashtag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, hashtag_id])
  @@index([hashtag_id])
}

/// Private "saved posts". Only ever read back by the user who saved them.
model bookmarks {
  user_id    String   @db.Uuid
  post_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, post_id])
  @@index([user_id, created_at(sort: Desc)])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model teams {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String       @db.VarChar(100)
  short_name String?      @db.VarChar(50)
  city       String?      @db.VarChar(100)
  country    String?      @db.VarChar(100)
  league     String?      @db.VarChar(100)
  logo_url   String?
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  post_teams post_teams[]
  user_teams user_teams[]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model topics {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @db.VarChar(100)
  description String?
  icon        String?       @db.VarChar(50)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  post_topics post_topics[]
  user_topics user_topics[]
}

model user_teams {
  user_id    String   @db.Uuid
  team_id    String   @db.Uuid
  is_primary Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  teams      teams    @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, team_id])
}

model user_topics {
  user_id    String   @db.Uuid
  topic_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  topics     topics   @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, topic_id])
}

enum AgeTier {
  JUNIOR
  STANDARD
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id                                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                            String        @db.VarChar(30)
  display_name                        String        @db.VarChar(100)
  email                               String        @db.VarChar(255)
  bio                                 String?
  profile_image_url                   String?
  date_of_birth                       DateTime      @db.Date
  is_onboarded                        Boolean       @default(false)
  age_tier                            AgeTier       @default(STANDARD)
  created_at                          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime      @default(now()) @db.Timestamptz(6)
  deleted_at                          DateTime?     @db.Timestamptz(6)
  cognito_sub                         String?       @unique @db.VarChar(64)
  follows_follows_follower_idTousers  follows[]     @relation("follows_follower_idTousers")
  follows_follows_following_idTousers follows[]     @relation("follows_following_idTousers")
  posts                               posts[]
  post_likes                          post_likes[]
  bookmarks                           bookmarks[]
  post_mentions                       post_mentions[]
  user_teams                          user_teams[]
  user_topics                         user_topics[]
}
